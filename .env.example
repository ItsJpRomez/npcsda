# Copy this file to .env.local (for your computer) and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
# Find both in Supabase → Project Settings → API Keys / Data API.
#
# These two values are public by design: Row Level Security in
# supabase/schema.sql decides what they can read or change.
# NEVER add the service_role key to this project.
#
# Leave them empty and the site runs on its built-in content.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
